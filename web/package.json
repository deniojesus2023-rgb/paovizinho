{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start --workdir ..",
    "db:stop": "supabase stop --workdir ..",
    "db:reset": "supabase db reset --workdir ..",
    "db:test": "psql \"${DB_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f ../supabase/testes/rls.sql",
    "db:types": "supabase gen types typescript --local --workdir .. > src/lib/supabase/database.types.ts",
    "functions:serve": "supabase functions serve --workdir .. --env-file ../supabase/.env"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "typescript": "^5"
  }
}
